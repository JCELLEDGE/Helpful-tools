  void drawStatusBar(bool heartbeatOn) {
  int barH = (selectedOrientation == 0) ? 22 : 18;

  // Place status bar at the bottom
  int barY = LCD_H - barH;

  // Clear status bar area
  M5.Display.fillRect(0, barY, LCD_W, barH, COL_BG);

  // Divider line above the bar
