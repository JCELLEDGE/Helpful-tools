// ============================================================
// HTTP TASK — Core 0 (Data‑Driven API Version)
// ============================================================
void httpTask(void*) {
  vTaskDelay(pdMS_TO_TICKS(50));

  TickType_t nextForcedPoll = 0;
  TickType_t lastBgPoll     = xTaskGetTickCount();

  for (;;) {
    CmdMsg cmd;
    bool didWork = false;

    // ---------------------------------------------------------
    // PROCESS COMMAND QUEUE
    // ---------------------------------------------------------
    while (xQueueReceive(cmdQ, &cmd, 0) == pdTRUE) {
      didWork = true;

      // Look up API definition for this command
      const ApiCommand* api = findApi(cmd.type);

      // -------------------------------------------------------
      // DATA‑DRIVEN COMMANDS (NEXT, PREV, HOME, CLEAR, FOCUS)
      // -------------------------------------------------------
      if (api) {
        String url = baseUrl() + api->url;

        enqueueStatus(api->labelOK);
        gCmdFlashColor = COL_GOOD;
        gCmdFlashUntil = millis() + 500;

        int code = 0;
        String body;

        bool ok =
          ensureWiFi() &&
          httpGET_once(url, code, body) &&
          (code == HTTP_CODE_NO_CONTENT || code == HTTP_CODE_OK);

        if (!ok) {
          enqueueStatus(api->labelERR);
          gCmdFlashColor = COL_BAD;
          gCmdFlashUntil = millis() + 500;

          gProOK = false;
        } else {
          // Commands that require a follow‑up poll
          if (cmd.type == CMD_NEXT ||
              cmd.type == CMD_PREV ||
              cmd.type == CMD_HOME0) {
            CmdMsg p{ CMD_POLL };
            xQueueSend(cmdQ, &p, 0);
            nextForcedPoll = xTaskGetTickCount() + kAfterTriggerDelay;
          }

          // Clear slide/text commands update local state
          if (cmd.type == CMD_CLEAR_SLIDE ||
              cmd.type == CMD_CLEAR_TEXT) {
            gTextCleared = true;
          }
        }
      }

      // -------------------------------------------------------
      // SPECIAL CASE: NET_UP (Wi‑Fi keepalive)
      // -------------------------------------------------------
      if (cmd.type == CMD_NET_UP) {
        ensureWiFi();
      }

      // -------------------------------------------------------
      // SPECIAL CASE: POLL (slide index)
      // -------------------------------------------------------
      if (cmd.type == CMD_POLL) {
        if (ensureWiFi()) {
          String err;
          if (!pollSlideOnce(err)) {
            vTaskDelay(kHttpRetryDelayTicks);
            pollSlideOnce(err);
          }
        }
      }
    }

    // ---------------------------------------------------------
    // FORCED POLL AFTER NEXT/PREV/HOME
    // ---------------------------------------------------------
    TickType_t now = xTaskGetTickCount();
    if (nextForcedPoll && now >= nextForcedPoll) {
      nextForcedPoll = 0;
      String err;
      pollSlideOnce(err);
    }

    // ---------------------------------------------------------
    // BACKGROUND POLL
    // ---------------------------------------------------------
    if (!didWork && (now - lastBgPoll) >= kPollIntervalTicks) {
    lastBgPoll = now;

    String err;
    pollSlideOnce(err);                 // slide index
    pollTransportPresentationCurrent(); // background media
}

    vTaskDelay(pdMS_TO_TICKS(10));
  }
}

// ============================================================
// UI TASK — Core 1 (Final, Flicker‑Free, Optimized)
// ============================================================
void uiTask(void*) {
  if (DEBUG) Serial.println("UI TASK STARTED");

  // Wait for Wi‑Fi + network info page to clear
  while (!gWifiOK || !gNetworkInfoDismissed)
    vTaskDelay(pdMS_TO_TICKS(50));

  // Wait for layout init
  while (LCD_W == 0 || LCD_H == 0) {
    if (DEBUG) Serial.println("WAITING FOR LAYOUT INIT");
    vTaskDelay(pdMS_TO_TICKS(500));
  }

  vTaskDelay(pdMS_TO_TICKS(200));

  UiMsg m;

  bool titleDirty    = true;
  bool cardDirty     = true;
  bool statusDirty   = true;
  bool slideNumDirty = true;

  long     lastRssi       = WiFi.RSSI();
  String   lastStatusText = gStatusText;
  int      lastSlideIndex = -1;

  bool     heartbeatOn    = false;
  uint32_t lastHB         = 0;

  for (;;) {

    // ---------------------------------------------------------
    // PROCESS UI QUEUE MESSAGES
    // ---------------------------------------------------------
    while (xQueueReceive(uiQ, &m, 0) == pdTRUE) {

      switch (m.type) {

        case UI_STATUS:
        case UI_WIFI:
          gStatusText = m.text;
          statusDirty = true;
          break;

        case UI_SLIDE:
          gSlideIndex = m.slideIndexOneBased;

          // Mark slide number bar dirty
          slideNumDirty = true;
          lastSlideIndex = gSlideIndex;

          // Update marquee
          gMarq.text = m.presName;
          sprTitle.setTextFont(2);
          gMarq.w        = sprTitle.textWidth(gMarq.text);
          gMarq.needed   = (gMarq.w > (LCD_W - 2 * PAD));
          gMarq.inPause  = false;
          gMarq.lastTick = millis();

          titleDirty = true;
          cardDirty  = true;
          break;

        case UI_THUMB:
          vTaskDelay(pdMS_TO_TICKS(50));
          cardDirty = true;
          break;
      }
    }

    // ---------------------------------------------------------
    // STATUS BAR CHANGE DETECTORS
    // ---------------------------------------------------------
    
    uint32_t now = millis();

    // Only update RSSI every 1 second
    static uint32_t lastRssiUpdate = 0;
    if (now - lastRssiUpdate > 1000) {
        lastRssiUpdate = now;

        long rssi = WiFi.RSSI();
        if (abs(rssi - lastRssi) > 8) {   // require a big change
            lastRssi = rssi;
            statusDirty = true;
        }
    } 

    // FIX: Only redraw slide number when index actually changes
    if (gSlideIndex != lastSlideIndex) {
        lastSlideIndex = gSlideIndex;
        slideNumDirty = true;
    }

    // Heartbeat toggle
    if (now - lastHB >= 500) {
        lastHB = now;
        heartbeatOn = !heartbeatOn;
        statusDirty = true;
    }

    if (gStatusText != lastStatusText) {
      lastStatusText = gStatusText;
      statusDirty = true;
    }
    // BG state changed?
    static bool lastBgActive = false;
    if (gBgActive != lastBgActive) {
        statusDirty = true;
        lastBgActive = gBgActive;
    }

    // ---------------------------------------------------------
    // TITLE / MARQUEE DRAW (TOP, SPRITE)
    // ---------------------------------------------------------
    if (titleDirty || gMarq.needed) {
      drawTitleMarqueeTick(COL_BG, COL_TEXT);
      sprTitle.pushSprite(0, TITLE_Y);
      titleDirty = false;
    }

    // ---------------------------------------------------------
    // CARD / THUMBNAIL DRAW (MIDDLE, SPRITE)
    // ---------------------------------------------------------
    if (cardDirty) {
      sprCard.fillSprite(COL_BG);

      if (gSlideIndex > 0 && !gThumbBuf.empty()) {
        if (gThumbMutex) xSemaphoreTake(gThumbMutex, portMAX_DELAY);

        int maxW = sprCard.width();
        int maxH = sprCard.height();

    // ---------------------------------------------------------
    // LANDSCAPE‑SPECIFIC SCALING + SHIFT
    // ---------------------------------------------------------
    float targetW = maxW;
    float targetH = maxH * 0.90f;   // portrait default

    int xShift  = 0;                // portrait default
    int yOffset = (maxH - targetH) / 2;
    if (yOffset < 0) yOffset = 0;

    if (selectedOrientation == 1) {
        // LANDSCAPE MODE
        targetW = maxW * 1.10f;     // slightly wider
        targetH = maxH * 0.92f;     // slightly shorter (prevents clipping)

        if (targetW > maxW) targetW = maxW;
        if (targetH > CARD_H) targetH = CARD_H;

        xShift  = -36;              // shift left for balance
        yOffset = (maxH - targetH) / 2;
        if (yOffset < 0) yOffset = 0;
    }

    // ---------------------------------------------------------
    // TEMP SPRITE FOR AUTO‑CENTERING
    // ---------------------------------------------------------
    int tW = (int)targetW;
    int tH = (int)targetH;

    M5Canvas temp(&M5.Display);
    temp.setColorDepth(16);
    temp.createSprite(tW, tH);
    temp.fillSprite(COL_BG);

    temp.drawJpg(
      gThumbBuf.data(),
      gThumbBuf.size(),
      0, 0,
      tW,
    tH
  );

        int left = maxW, right = 0;
        for (int x = 0; x < maxW; x++) {
          for (int y = 0; y < targetH; y++) {
            if (temp.readPixel(x, y) != COL_BG) {
              if (x < left) left = x;
              if (x > right) right = x;
            }
          }
        }

        int scaledW = right - left + 1;
        int xOffset = (maxW - scaledW) / 2;
        if (xOffset < 0) xOffset = 0;

        sprCard.drawJpg(
          gThumbBuf.data(),
          gThumbBuf.size(),
          xOffset,
          yOffset,
          maxW,
          targetH
        );

        temp.deleteSprite();
        if (gThumbMutex) xSemaphoreGive(gThumbMutex);
      }

      sprCard.pushSprite(PAD, CARD_Y);
      cardDirty = false;
    }

    // ---------------------------------------------------------
    // STATUS BAR (BOTTOM, DIRECT)
    // ---------------------------------------------------------
    if (statusDirty) {
      drawStatusBar(heartbeatOn);
      statusDirty = false;
    }

    // ---------------------------------------------------------
    // SLIDE NUMBER BAR (ABOVE STATUS BAR, ONLY WHEN DIRTY)
    // ---------------------------------------------------------
    if (slideNumDirty) {
      drawSlideNumberBar();
      slideNumDirty = false;
    }

    // ---------------------------------------------------------
    // Command flash timeout → force redraw to clear border
    // ---------------------------------------------------------
    static bool flashWasActive = false;
    bool flashActive = (millis() < gCmdFlashUntil);

    if (flashActive != flashWasActive) {
        slideNumDirty = true;   // force redraw when flash starts or ends
        flashWasActive = flashActive;
    }

    vTaskDelay(pdMS_TO_TICKS(10));
  }
}
