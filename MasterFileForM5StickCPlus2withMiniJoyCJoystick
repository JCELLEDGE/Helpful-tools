void runOrientationMenu() {
  M5.Lcd.fillScreen(COL_BG);
  M5.Lcd.setTextFont(2);
  M5.Lcd.setTextColor(COL_TEXT, COL_BG);

  const char* options[2] = { "Portrait", "Landscape" };
  int highlight = 0;
  int lastHighlight = -1;

  auto drawMenu = [&](int hl) {
    M5.Lcd.fillScreen(COL_BG);
    M5.Lcd.setCursor(10, 10);
    M5.Lcd.println("Select Orientation:");
    for (int i = 0; i < 2; i++) {
      M5.Lcd.setTextColor(i == hl ? TFT_BLACK : TFT_WHITE,
                          i == hl ? TFT_WHITE : COL_BG);
      M5.Lcd.setCursor(20, 40 + i * 25);
      M5.Lcd.println(options[i]);
    }
  };

  drawMenu(highlight);
  lastHighlight = highlight;

  while (true) {
    M5.update();
    JoyState js = readJoystickMiniJoyC();
    if (js.y > 20) { highlight = (highlight + 1) % 2; delay(150); }
    if (js.y < -20){ highlight = (highlight + 1) % 2; delay(150); }
    if (highlight != lastHighlight) {
      drawMenu(highlight);
      lastHighlight = highlight;
    }
    if (js.btn == 1 || M5.BtnA.wasPressed()) {
      selectedOrientation = highlight;
      break;
    }
    delay(10);
  }

  M5.Lcd.setRotation(selectedOrientation == 0 ? 0 : 1);
  M5.Lcd.fillScreen(COL_BG);
  delay(50);
}
