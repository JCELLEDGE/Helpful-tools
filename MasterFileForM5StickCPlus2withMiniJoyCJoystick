void runStartupMenu() {
  M5.Lcd.fillScreen(COL_BG);
  M5.Lcd.setTextFont(2);
  M5.Lcd.setTextColor(COL_TEXT, COL_BG);

  int profileCount = sizeof(profiles) / sizeof(Profile);
  int highlight = 0;
  int lastHighlight = -1;

  auto drawMenu = [&](int hl) {
    M5.Lcd.fillScreen(COL_BG);
    M5.Lcd.setCursor(10, 10);
    M5.Lcd.println("Select Profile:");

    for (int i = 0; i < profileCount; i++) {
      M5.Lcd.setTextColor(
        (i == hl) ? TFT_BLACK : TFT_WHITE,
        (i == hl) ? TFT_WHITE : COL_BG
      );

      M5.Lcd.setCursor(20, 40 + i * 25);
      M5.Lcd.printf("%d) %s", i + 1, profiles[i].name);
    }
  };

  drawMenu(highlight);
  lastHighlight = highlight;

  while (true) {
    M5.update();
    JoyState js = readJoystickMiniJoyC();

    if (js.y > 20) {
      highlight--;
      if (highlight < 0) highlight = profileCount - 1;
      delay(150);
    }
    if (js.y < -20) {
      highlight++;
      if (highlight >= profileCount) highlight = 0;
      delay(150);
    }

    if (highlight != lastHighlight) {
      drawMenu(highlight);
      lastHighlight = highlight;
    }

    if (js.btn == 1 || M5.BtnA.wasPressed()) {
      selectedProfile = highlight;
      break;
    }

    delay(10);
  }

  strncpy(wifiSSID, profiles[selectedProfile].ssid, sizeof(wifiSSID) - 1);
  wifiSSID[sizeof(wifiSSID) - 1] = '\0';

  strncpy(wifiPassword, profiles[selectedProfile].password, sizeof(wifiPassword) - 1);
  wifiPassword[sizeof(wifiPassword) - 1] = '\0';

  pro7NetworkAddress = profiles[selectedProfile].ip;
  pro7NetworkPort    = profiles[selectedProfile].port;

  WiFi.mode(WIFI_STA);
  WiFi.begin(wifiSSID, wifiPassword);

  showNetworkInfoPage();
  gOnInfoPage = true;
}
