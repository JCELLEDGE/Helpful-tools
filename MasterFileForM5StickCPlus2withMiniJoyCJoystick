void drawSlideNumberBar() {
    if (gSlideIndex <= 0) return;

    String s = String(gSlideIndex);

    // ---------------------------------------------------------
    // FONT SELECTION
    // ---------------------------------------------------------
    if (selectedOrientation == 0) {
        M5.Lcd.setTextFont(6);   // PORTRAIT → big
    } else {
        M5.Lcd.setTextFont(4);   // LANDSCAPE → medium
    }

    int textW = M5.Lcd.textWidth(s);
    int textH = M5.Lcd.fontHeight();

    int padX = 10;
    int padY = 4;

    int boxW = textW + padX * 2;
    int boxH = textH + padY * 2;

    int boxX, boxY;

    // ---------------------------------------------------------
    // PORTRAIT MODE — centered horizontally, above status bar
    // ---------------------------------------------------------
    if (selectedOrientation == 0) {
        boxX = (LCD_W - boxW) / 2;

        // Corrected: only one status bar now
        boxY = LCD_H - STATUS_H - boxH - 6;
    }

    // ---------------------------------------------------------
    // LANDSCAPE MODE — centered vertically relative to thumbnail
    // ---------------------------------------------------------
    else {
        boxX = LCD_W - boxW - 8;

        int cardCenterY = CARD_Y + (CARD_H / 2);
        boxY = cardCenterY - (boxH / 2);
    }
    // ---------------------------------------------------------
    // ERASE BORDER AREA (prevents stuck border)
    // ---------------------------------------------------------
    M5.Lcd.fillRect(
        boxX - 3,
        boxY - 3,
        boxW + 6,
        boxH + 6,
        COL_BG
    );

    // ---------------------------------------------------------
    // DRAW BOX
    // ---------------------------------------------------------
    M5.Lcd.fillRoundRect(boxX, boxY, boxW, boxH, 6, COL_MUTED);

    // Flash border if command feedback active
    if (millis() < gCmdFlashUntil) {
        M5.Lcd.drawRoundRect(boxX - 2, boxY - 2, boxW + 4, boxH + 4, 8, gCmdFlashColor);
    }

    // ---------------------------------------------------------
    // DRAW TEXT
    // ---------------------------------------------------------
    int textX = boxX + (boxW - textW) / 2;
    int textY = boxY + (boxH - textH) / 2;

    M5.Lcd.setTextColor(TFT_BLACK, COL_MUTED);
    M5.Lcd.setCursor(textX, textY);
    M5.Lcd.print(s);
}

