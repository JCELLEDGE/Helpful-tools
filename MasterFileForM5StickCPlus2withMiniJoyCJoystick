  // Font setup
  M5.Display.setTextFont(1);
  M5.Display.setTextColor(COL_TEXT, COL_BG);

  // HEARTBEAT ICON (LEFT)
  int hbX = 4;
  int hbY = barY + 4;  // <-- relative to bar
  uint16_t hbColor = heartbeatOn ? TFT_RED : 0xA000;
  M5.Display.fillCircle(hbX, hbY + 4, 3, hbColor);

  // PROFILE NAME (next to heartbeat)
  const char* profName = profiles[selectedProfile].name;
  M5.Display.setCursor(hbX + 12, hbY);
  M5.Display.print(profName);

// ---------------------------------------------------------
// PROPRESENTER STATUS INDICATOR ("P" glyph)
// ---------------------------------------------------------
int pX = hbX + 12 + M5.Display.textWidth(profName) + 10;
int pY = hbY;

uint16_t pColor;
if (gProOK)      pColor = COL_GOOD;   // green
else if (!gWifiOK) pColor = COL_MUTED; // gray if Wi‑Fi down
else             pColor = COL_BAD;    // red if ProPresenter unreachable

M5.Display.setTextColor(pColor, COL_BG);
M5.Display.setCursor(pX, pY);
M5.Display.print("P");
// ---------------------------------------------------------
// BG TEXT BADGE ("BKG")
// ---------------------------------------------------------
int bkgX = pX + 14;   // position just after the "P"
int bkgY = pY;

uint16_t bkgColor;

if (!gProOK) {
    bkgColor = COL_MUTED;        // gray when ProPresenter unreachable
} else if (gTransport.isPlaying) {
    bkgColor = COL_GOOD;         // green when BG media active
} else {
    bkgColor = COL_BAD;          // red when no BG media
}

M5.Display.setTextFont(1);
M5.Display.setTextColor(bkgColor, COL_BG);
M5.Display.setCursor(bkgX, bkgY);
M5.Display.print("BKG");


  // WIFI SIGNAL BARS (RIGHT)
  int barsX = LCD_W - 20;
  int barsY = barY + 4;      // <-- relative to bar
  int barW = 3;
  int barGap = 2;

  int strength = WiFi.RSSI();
  int level = 0;
  if (strength > -50) level = 3;
  else if (strength > -70) level = 2;
  else if (strength > -85) level = 1;

  uint16_t barColor = gWifiOK ? COL_GOOD : COL_MUTED;

  for (int i = 0; i < 3; i++) {
    int h = 3 + i * 2;
    int x = barsX + i * (barW + barGap);
    int y = barsY + (6 - h);     // <-- also relative to bar
    if (i < level) {
      M5.Display.fillRect(x, y, barW, h, barColor);
    } else {
      M5.Display.drawRect(x, y, barW, h, COL_MUTED);
    }
  }
}

