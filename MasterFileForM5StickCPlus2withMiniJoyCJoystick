// LOOKUP FUNCTION
// ============================================================
const ApiCommand* findApi(CmdType t) {
    for (size_t i = 0; i < sizeof(apiTable) / sizeof(apiTable[0]); i++) {
        if (apiTable[i].type == t) {
            return &apiTable[i];
        }
    }
    return nullptr;
}

