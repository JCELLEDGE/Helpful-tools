JoyState readJoystickMiniJoyC() {
  JoyState js{0, 0, 0};

  // Raw MiniJoyC values
  js.x   = joyc.getPOSValue(0, _8bit);   // X axis
  js.y   = joyc.getPOSValue(1, _8bit);   // Y axis
  js.btn = joyc.getButtonStatus() ? 0 : 1;

  if (selectedOrientation == 0) {
    // ---------------------------------------------------------
    // PORTRAIT — rotate 90° CCW (your current working behavior)
    // x' =  y
    // y' = -x
    // ---------------------------------------------------------
    int oldX = js.x;
    int oldY = js.y;
    js.x =  oldY;     // vertical (UP/DOWN)
    js.y = -oldX;     // horizontal (LEFT/RIGHT)
  }
  else {
    // ---------------------------------------------------------
    // LANDSCAPE — rotate 90° CW + fix inversion
    // x' =  y
    // y' = -x
    //
    // This matches your Portrait transform but applied
    // to the joystick's physical orientation in Landscape.
    // ---------------------------------------------------------
    int oldX = js.x;
    int oldY = js.y;
    js.x =  oldY;     // vertical (UP/DOWN)
    js.y = -oldX;     // horizontal (LEFT/RIGHT)
  }

  return js;
}
