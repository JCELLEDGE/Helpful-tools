String baseUrl() {
  return "http://" + pro7NetworkAddress + ":" + pro7NetworkPort;
}

bool httpGET_once(const String& url, int& code, String& body) {
  WiFiClient client;
  client.setNoDelay(true);
  client.setTimeout(3000);

  HTTPClient http;
  http.useHTTP10(true);

  if (!http.begin(client, url)) {
    code = -1000;
    return false;
  }

  http.addHeader("Connection", "close");
  http.setTimeout(3000);

  code = http.GET();
  if (code > 0) {
    body = http.getString();
    gWifiOK = true;
  }
  http.end();
  return code > 0;
}

bool fetchThumbnailBytes(const String& uuid, int slideIndex, int slideIndexOneBased) {
  String url = baseUrl() + "/v1/presentation/" + uuid +
               "/thumbnail/" + String(slideIndex) +
               "?quality=136&thumbnail_type=jpeg";

  WiFiClient client;
  client.setNoDelay(true);
  client.setTimeout(3000);

  HTTPClient http;
  http.useHTTP10(true);

  if (!http.begin(client, url)) return false;

  http.addHeader("Connection", "close");
  http.setTimeout(3000);

  int code = http.GET();
  if (code != HTTP_CODE_OK) {
    http.end();
    return false;
  }

  int len = http.getSize();

  if (gThumbMutex) xSemaphoreTake(gThumbMutex, portMAX_DELAY);
  gThumbBuf.clear();

  WiFiClient* stream = http.getStreamPtr();

  if (len > 0) {
    gThumbBuf.resize(len);
    int readTotal = 0;
    while (readTotal < len) {
      int n = stream->readBytes((char*)gThumbBuf.data() + readTotal, len - readTotal);
      if (n <= 0) break;
      readTotal += n;
    }
    if (readTotal != len) {
      http.end();
      if (gThumbMutex) xSemaphoreGive(gThumbMutex);
      return false;
    }
  } else {
    uint8_t buf[256];
    while (http.connected()) {
      int avail = stream->available();
      if (avail <= 0) {
        vTaskDelay(pdMS_TO_TICKS(10));
        continue;
      }
      int n = stream->readBytes((char*)buf, min(avail, (int)sizeof(buf)));
      if (n <= 0) break;
      gThumbBuf.insert(gThumbBuf.end(), buf, buf + n);
    }
  }

  http.end();
  bool empty = gThumbBuf.empty();
  if (gThumbMutex) xSemaphoreGive(gThumbMutex);

  return !empty;
}
bool pollTransportPresentationCurrent() {
  String url = baseUrl() + "/v1/transport/presentation/current?chunked=false";

  int code = 0;
  String payload;

  if (!httpGET_once(url, code, payload)) {
    gTransport.isPlaying = false;
    gTransport.name = "";
    return false;
  }

  if (code != HTTP_CODE_OK) {
    gTransport.isPlaying = false;
    gTransport.name = "";
    return false;
  }

  StaticJsonDocument<1024> doc;
  auto err = deserializeJson(doc, payload);
  if (err) {
    gTransport.isPlaying = false;
    gTransport.name = "";
    return false;
  }

  gTransport.isPlaying = doc["is_playing"] | false;
  gTransport.name      = doc["name"]       | "";

if (DEBUG) Serial.println("--- TRANSPORT POLL ---");
if (DEBUG) Serial.print("is_playing: ");
if (DEBUG) Serial.println(gTransport.isPlaying ? "true" : "false");
if (DEBUG) Serial.print("name: ");
if (DEBUG) Serial.println(gTransport.name);
if (DEBUG) Serial.println("----------------------");

  return true;
}

