//============================================================
// POLL SLIDE INDEX
// ============================================================
bool pollSlideOnce(String& errMsg) {
  String url = baseUrl() + "/v1/presentation/slide_index";

  if (DEBUG) Serial.println("--- SLIDE INDEX POLL ---");
  if (DEBUG) Serial.print("URL: ");
  if (DEBUG) Serial.println(url);
  if (DEBUG) Serial.print("WiFi IP: ");
  if (DEBUG) Serial.println(WiFi.localIP());
  if (DEBUG) Serial.println("------------------------");

  int code = 0;
  String payload;

  if (!httpGET_once(url, code, payload)) {
    errMsg = "Poll fail";
    gProOK = false;
    return false;
  }

  if (DEBUG) Serial.print("HTTP code: ");
  if (DEBUG) Serial.println(code);

  if (code != HTTP_CODE_OK) {
    errMsg = "HTTP";
    gProOK = false;
    enqueueStatus("ReqFail");
    return false;
  }

  StaticJsonDocument<2048> doc;
  auto err = deserializeJson(doc, payload);
  if (err) {
    errMsg = "Bad JSON";
    gProOK = false;
    return false;
  }

  int idx1 = -1;
  const char* name = "";
  const char* uuidC = nullptr;

  JsonObject pi = doc["presentation_index"];
  if (!pi.isNull()) {
    if (pi.containsKey("index")) idx1 = (int)pi["index"] + 1;
    JsonObject pid = pi["presentation_id"];
    if (!pid.isNull()) {
      if (pid.containsKey("name")) name = pid["name"];
      if (pid.containsKey("uuid")) uuidC = pid["uuid"];
    }
  }

  String uuid = uuidC ? String(uuidC) : "";

  if (DEBUG) Serial.print("Parsed idx1: ");
  if (DEBUG) Serial.println(idx1);
  if (DEBUG) Serial.print("Parsed name: ");
  if (DEBUG) Serial.println(name);
  if (DEBUG) Serial.print("Parsed uuid: ");
  if (DEBUG) Serial.println(uuid);
  if (DEBUG) Serial.println("------------------------");

// Background media active?
if (doc.containsKey("presentation_index") &&
    doc["presentation_index"].containsKey("presentation_id") &&
    doc["presentation_index"]["presentation_id"].containsKey("backgrounds")) {

    JsonArray bgs = doc["presentation_index"]["presentation_id"]["backgrounds"];
    gBgActive = (bgs.size() > 0);
} else {
    gBgActive = false;
}

  // Treat -1 as "no active slide", not an error
  if (idx1 >= 0) {
    gProOK = true;
  } else {
    // Slide layer cleared — keep ProPresenter marked OK
    gProOK = true;
    idx1 = 0;  // display nothing instead of -1
  }

  // Update UI: slide index + title
  enqueueSlide(idx1, name);

  // Update status line text so we aren't stuck on "Booting"
  if (gProOK) {
    enqueueStatus("P:T OK");
  }

  if (idx1 > 0) gTextCleared = false;

  if (idx1 > 0 && uuid.length() > 0) {
    int thumbIndex = idx1 - 1;
    if (fetchThumbnailBytes(uuid, thumbIndex, idx1)) {
      enqueueThumb(idx1);
    }
  }

  return true;
}

