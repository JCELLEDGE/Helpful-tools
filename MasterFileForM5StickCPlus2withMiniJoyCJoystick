  }

  if (M5.BtnPWR.wasPressed()) {
    CmdMsg c{ CMD_HOME0 };
    xQueueSend(cmdQ, &c, 0);
  }

  // ---------------------------------------------------------
  // JOYSTICK READ
  // ---------------------------------------------------------
  JoyState js = readJoystickMiniJoyC();

  // Direction string
  String dir;

  // With your current rotation + fixes:
  // js.x = vertical (UP/DOWN), js.y = horizontal (LEFT/RIGHT)
  int vert  = js.x;       // up/down
  int horiz = js.y;       // left/right

  static String lastDir = "";

  // ---------------------------------------------------------
// DIRECTION DETECTION (drift‑proof)
// ---------------------------------------------------------

const int DEADZONE = 12;        // ignore tiny drift
const int STRONG   = 25;        // strong push threshold

// Default
dir = "CENTER";

// Strong horizontal movement → LEFT/RIGHT wins
if (abs(horiz) > STRONG && abs(horiz) > abs(vert)) {
    dir = (horiz > 0) ? "LEFT" : "RIGHT";
}
// Strong vertical movement → UP/DOWN wins
else if (abs(vert) > STRONG && abs(vert) > abs(horiz)) {
    dir = (vert > 0) ? "UP" : "DOWN";
}
// Weak movement → treat as CENTER
else if (abs(vert) < DEADZONE && abs(horiz) < DEADZONE) {
    dir = "CENTER";
}

  // ---------------------------------------------------------
  // LED FEEDBACK (correct for your UNIT_JOYC library)
  // ---------------------------------------------------------
  if (dir == "UP") {
    joyc.setLEDColor(0, 0x00FF00);      // Green
  }
  else if (dir == "DOWN") {
    joyc.setLEDColor(0, 0xFF0000);      // Red
  }
  else if (dir == "LEFT") {
    joyc.setLEDColor(0, 0x0000FF);      // Blue
  }
  else if (dir == "RIGHT") {
    joyc.setLEDColor(0, 0xFFFF00);      // Yellow
  }
  else {
    joyc.setLEDColor(0, 0x000000);      // Off
  }

  // ---------------------------------------------------------
  // COMMAND MAPPING (Portrait vs Landscape, data-driven)
  // ---------------------------------------------------------
  static bool joyLatched = false;       // prevents repeat firing
  static uint32_t lastJoyTime = 0;
  const uint32_t JOY_COOLDOWN = 220;    // ms

  uint32_t now = millis();

  // Reset latch when centered
  if (dir == "CENTER") {
    joyLatched = false;
  }

  // Only fire if not latched and cooldown passed
  if (!joyLatched && (now - lastJoyTime > JOY_COOLDOWN)) {
    const JoyMap* map = nullptr;
    int mapSize = 0;

    if (selectedOrientation == 0) {
      // PORTRAIT
      map = kPortraitJoyMap;
      mapSize = sizeof(kPortraitJoyMap) / sizeof(kPortraitJoyMap[0]);
    } else {
      // LANDSCAPE
      map = kLandscapeJoyMap;
      mapSize = sizeof(kLandscapeJoyMap) / sizeof(kLandscapeJoyMap[0]);
    }

    if (map) {
      for (int i = 0; i < mapSize; ++i) {
        if (dir == map[i].dir) {
          CmdMsg c{ map[i].cmd };
          xQueueSend(cmdQ, &c, 0);
          joyLatched = true;
          break;
        }
      }
    }

    lastJoyTime = now;
  }

  // ---------------------------------------------------------
  // JOYSTICK BUTTON = CLEAR SLIDE
  // ---------------------------------------------------------
  static bool joyBtn = false;

  if (js.btn == 1 && !joyBtn) {
    joyBtn = true;
    CmdMsg c{ CMD_CLEAR_SLIDE };
    xQueueSend(cmdQ, &c, 0);
  }
  if (js.btn != 1) joyBtn = false;

  // ---------------------------------------------------------
  // WIFI KEEPALIVE
  // ---------------------------------------------------------
  static uint32_t lastKick = 0;
  if (now - lastKick > 3000) {
    lastKick = now;
    if (!gWifiOK || WiFi.status() != WL_CONNECTED) {
      CmdMsg c{ CMD_NET_UP };
      xQueueSend(cmdQ, &c, 0);
    }
  }

  // ---------------------------------------------------------
  // LOOP DELAY
  // ---------------------------------------------------------
  vTaskDelay(pdMS_TO_TICKS(10));
}
